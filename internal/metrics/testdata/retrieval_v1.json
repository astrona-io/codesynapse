    "payments.go": "package payments\n\nimport \"errors\"\n\n// Charge validates an invoice before scheduling settlement.\nfunc Charge(amount int) error {\n\tif err := Validate(amount); err != nil {\n\t\treturn err\n\t}\n\treturn Settle(amount)\n}\n\n// Validate rejects a zero or negative invoice amount.\nfunc Validate(amount int) error {\n\tif amount <= 0 {\n\t\treturn errors.New(\"E-PAY.42\")\n\t}\n\treturn nil\n}\n\n// Settle writes an approved invoice to the local settlement queue.\nfunc Settle(amount int) error {\n\t_ = amount\n\treturn nil\n}\n",
    "handler.go": "package payments\n\n// Handler passes the invoice amount to Charge and preserves validation errors.\nfunc Handler(amount int) error {\n\treturn Charge(amount)\n}\n",
    "payments_test.go": "package payments\n\nimport \"testing\"\n\nfunc TestCharge(t *testing.T) {\n\tif err := Charge(0); err == nil {\n\t\tt.Fatal(\"expected invalid invoice error\")\n\t}\n\tif err := Charge(100); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n",
    "policy.md": "# Invoice policy\n\nE-PAY.42 identifies a non-positive invoice amount.\nPolicy clause INV-4.2 requires positive invoice amounts.\nSettlement host payments.eu.example is used by the invoice worker.\nFaktura 支払い describes invoice payment in the multilingual operator glossary.\n"
