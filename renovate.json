{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "vue-tsc (nuxt typecheck) loads typescript/lib/tsc, which TypeScript 7 no longer exports; AGENTS.md pins 5.x until vue-tsc supports newer releases",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6"
    },
    {
      "description": "A Go major version is a new import path: bumping go.mod alone leaves the code on the old version and can break the build (#82, #83, #85, #86). Wait for approval on the dependency dashboard and migrate the imports in the same change.",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The same for tools run with `go run module@version`: a new major version needs the /vN module path in the command, which Renovate does not add (#129).",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The four NebulaGraph images are one release: bump them together",
      "matchPackageNames": [
        "/(^|/)(codesynapse-)?nebula-(metad|storaged|graphd|console)$/"
      ],
      "groupName": "NebulaGraph"
    }
  ],
  "customManagers": [
    {
      "description": "Check tools run with `go run module@version` (justfile, CI scripts)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)justfile$/",
        "/^\\.github/scripts/.+\\.sh$/"
      ],
      "matchStrings": [
        "go run (?<depName>[^@\\s]+?)(?:/cmd/[^@\\s]+)?@(?<currentValue>v[0-9][^\\s]*)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "description": "Check tool images on ghcr.io (justfile)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)justfile$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/[^:\\s]+):(?<currentValue>v?[0-9][^\\s]*)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Python check tools run with uvx (justfile)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)justfile$/"
      ],
      "matchStrings": [
        "--from (?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Store images of the Helm chart: the top-level image of each subchart, the NebulaGraph images map, and vmalert (alerting.image) in the parent chart",
      "customType": "regex",
      "managerFilePatterns": [
        "/^deploy/helm/codesynapse/charts/[^/]+/values\\.yaml$/",
        "/^deploy/helm/codesynapse/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)image: (?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)",
        "\\n  (?:metad|storaged|graphd|console): (?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)",
        "\\n  image: (?<depName>[^:\\s]+/vmalert):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Versions pinned in Dockerfile ARGs, marked with a `# renovate: datasource=... depName=...` comment on the line above (golang.org/x modules patched into the store images)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s*\\nARG [A-Z0-9_]+=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "description": "golangci-lint version in CI",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "golangci-lint-action@.*\\n\\s+with:\\n\\s+version: (?<currentValue>v[0-9][^\\s]*)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    }
  ]
}
