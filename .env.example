# Copy to .env (git-ignored). Generate secrets with: openssl rand -hex 24
CODESYNAPSE_API_TOKEN=change-me-api-token
CODESYNAPSE_MCP_TOKEN=change-me-mcp-token
# PostgreSQL for users, organisations, API keys and the audit log.
POSTGRES_PASSWORD=change-me-postgres
# Graph database: Apache HugeGraph, with Milvus for agent-memory vectors.
HUGEGRAPH_PASSWORD=change-me-hugegraph
# VictoriaMetrics (statistics by minute and hour).
METRICS_PASSWORD=change-me-metrics
# Seals organisation Git tokens (AES-256-GCM). Keep it: without it stored
# tokens cannot be opened and have to be set again. openssl rand -base64 32
SECRET_KEY=change-me-secret-key
# Let anyone sign up after the first account (the first becomes platform admin).
CODESYNAPSE_SIGNUP_OPEN=false
# Days the audit log is kept (NIS2 evidence; at least 30).
CODESYNAPSE_AUDIT_RETENTION_DAYS=400
# Directory whose subdirectories are the repositories to index.
SOURCES_DIR=./sources
# Allow `go list` to download modules during ingest (trusted repos only).
CODESYNAPSE_ALLOW_NETWORK=false
# Check dependencies for known CVEs via osv.dev during ingest. Only module
# paths and versions leave the machine.
CODESYNAPSE_VULN_SCAN=true
# Resolve Go calls through function values with data-flow analysis (SSA and
# VTA). Adds edges marked "dataflow"; costs extra ingest time and memory.
CODESYNAPSE_INGEST_DATAFLOW=false
# Token for cloning private repositories added by URL (sent only to this host).
CODESYNAPSE_GIT_TOKEN=
CODESYNAPSE_GIT_TOKEN_HOST=github.com
# Allow git remotes on private networks (self-hosted forges).
CODESYNAPSE_ALLOW_PRIVATE_GIT=false
# Let CodeSynapse push fix branches (codesynapse/*) for accepted review
# comments and open draft pull requests, so CI runs on them. Needs a token
# with Contents: read and write and Pull requests: read and write.
CODESYNAPSE_ALLOW_PUSH=false
CODESYNAPSE_GIT_AUTHOR_NAME=CodeSynapse
CODESYNAPSE_GIT_AUTHOR_EMAIL=codesynapse@localhost
# Host port for the API (change if another service, e.g. a local model server, uses 8080).
CODESYNAPSE_API_PORT=8080
# Keys for cloud AI providers named in config/llm.yaml (leave empty for local models).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
