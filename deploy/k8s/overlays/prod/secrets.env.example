# Copy to secrets.env (git-ignored) or run `just k8s-secrets <overlay>`.
CODESYNAPSE_API_TOKEN=change-me-api-token
CODESYNAPSE_MCP_TOKEN=change-me-mcp-token
# Optional: private repositories on github.com, and cloud AI providers.
CODESYNAPSE_GIT_TOKEN=
# Tokens for several git hosts, host=token comma separated (each is sent to its host only)
CODESYNAPSE_GIT_TOKENS=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
