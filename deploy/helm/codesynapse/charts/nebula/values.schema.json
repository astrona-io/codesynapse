{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "In-chart NebulaGraph values",
  "description": "Override these under `nebula:` in the codesynapse chart's values.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Set in the codesynapse chart.",
      "type": "object"
    },
    "enabled": {
      "description": "Set in the codesynapse chart (condition).",
      "type": "boolean"
    },
    "images": {
      "description": "Image references with registry and tag.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metad": {"description": "Meta service.", "type": "string", "minLength": 1},
        "storaged": {"description": "Storage service.", "type": "string", "minLength": 1},
        "graphd": {"description": "Query service, the only one the other pods reach.", "type": "string", "minLength": 1},
        "console": {"description": "Registers the storage host and replaces the first root password at start.", "type": "string", "minLength": 1}
      }
    },
    "size": {
      "description": "Size of the data volume.",
      "$ref": "#/definitions/quantity"
    },
    "storageClass": {
      "description": "Storage class of the data volume; empty uses the cluster default.",
      "type": "string"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceList"
        },
        "limits": {
          "$ref": "#/definitions/resourceList"
        }
      }
    },
    "externalAddrs": {
      "description": "Set in the codesynapse chart: the graphd addresses to use when this store is disabled.",
      "type": "string",
      "pattern": "^([^,:\\s]+:[0-9]+(,[^,:\\s]+:[0-9]+)*)?$"
    }
  },
  "definitions": {
    "quantity": {
      "description": "A Kubernetes quantity, e.g. 250m, 1Gi or 2.",
      "type": [
        "string",
        "number"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/quantity"
      }
    }
  }
}
