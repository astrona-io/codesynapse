{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "session"], "timeout": 10 }] },
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["memory", "recall", "--hook"], "timeout": 30 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["memory", "offload", "--hook"], "timeout": 60 }] }
    ],
    "PreToolUse": [
      { "matcher": "Read", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "read"], "timeout": 10 }] },
      { "matcher": "Read|Grep|Glob|mcp__.*codesynapse.*", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lookup"], "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "mcp__.*codesynapse.*", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "answer"], "timeout": 10 }] },
      { "matcher": "Read", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "read-done"], "timeout": 10 }] },
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "edit"], "timeout": 10 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "edit-failed"], "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "prompt"], "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "stop"], "timeout": 30 }] }
    ]
  }
}
