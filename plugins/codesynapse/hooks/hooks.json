{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "session"], "timeout": 10 }] },
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["memory", "recall", "--hook"], "timeout": 30 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["memory", "offload", "--hook"], "timeout": 60 }] },
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "PreCompact"], "timeout": 15 }] }
    ],
    "PreToolUse": [
      { "matcher": "Read", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "read"], "timeout": 10 }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "bash"], "timeout": 10 }] },
      { "matcher": "Read|Grep|Glob|mcp__.*codesynapse.*", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lookup"], "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "mcp__.*codesynapse.*", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "answer"], "timeout": 10 }] },
      { "matcher": "Read", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "read-done"], "timeout": 10 }] },
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "edit"], "timeout": 10 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "edit-failed"], "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "prompt"], "timeout": 5 }] },
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["memory", "recall", "--hook"], "timeout": 8 }] },
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "brief"], "timeout": 180 }] }
    ],
    "CwdChanged": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "CwdChanged"], "timeout": 15 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "SessionEnd"], "timeout": 2 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "SubagentStart"], "timeout": 15 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "SubagentStop"], "timeout": 15 }] }
    ],
    "PostCompact": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "PostCompact"], "timeout": 15 }] }
    ],
    "PostToolBatch": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "PostToolBatch"], "timeout": 15 }] }
    ],
    "InstructionsLoaded": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "InstructionsLoaded"], "timeout": 15 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "PermissionRequest"], "timeout": 15 }] }
    ],
    "PermissionDenied": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "PermissionDenied"], "timeout": 15 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "lifecycle", "--client", "claude", "--event", "StopFailure"], "timeout": 15 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "codesynapse", "args": ["hook", "stop"], "timeout": 30 }] }
    ]
  }
}
